{
  "name": "regassa-automations-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:links": "linkinator dist --recurse --check-fragments --skip \"^https?://(?!(localhost|127\\.0\\.0\\.1|\\[::1\\])[:/])\"",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:browsers": "CROSS=1 playwright test --project mobile-webkit --project desktop-firefox --workers 2"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "astro": "^7.4.13",
    "js-yaml": "^5.5.0"
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "html-validate": "^11.21.1",
    "linkinator": "^8.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
