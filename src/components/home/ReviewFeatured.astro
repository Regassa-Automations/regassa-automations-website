---
/** Featured review: navy panel (03-design-system.md, Featured review). */
import StarRating from '../ui/StarRating.astro';

interface Props {
  quote: string;
  attribution: string;
  projectLabel: string;
  projectLabelMobile?: string;
  link: { label: string; href: string };
}
const { quote, attribution, projectLabel, projectLabelMobile, link } = Astro.props;
---

<figure class="rfeat on-navy">
  <blockquote class="rfeat__quote">
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="rfeat__caption">
    <StarRating class="rfeat__stars" />
    <span>
      {attribution} · <span class="bp-desktop">{projectLabel}</span>
      <span class="bp-mobile">{projectLabelMobile ?? projectLabel}</span>
    </span>
    <a class="rfeat__link" href={link.href}>
      {link.label}
    </a>
  </figcaption>
</figure>

<style>
  .rfeat {
    padding: 40px 44px;
    background: var(--navy);
    border-radius: 12px;
    color: var(--on-navy);
  }

  .rfeat__quote p {
    max-width: 34em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    line-height: 40px;
  }

  .rfeat__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) 18px;
    margin-top: 20px;
    font-size: 15px;
    line-height: 22px;
    color: var(--on-navy-muted);
  }

  .rfeat__caption :global(.rfeat__stars) {
    color: var(--on-navy);
    font-size: 16px;
  }

  .rfeat__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--on-navy);
  }

  .rfeat__link:hover {
    color: var(--on-navy);
  }

  @media (max-width: 767px) {
    .rfeat {
      padding: 24px 20px;
      border-radius: var(--radius-lg);
    }

    .rfeat__quote p {
      font-size: 19px;
      line-height: 28px;
    }

    .rfeat__caption {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
      margin-top: var(--space-4);
      font-size: 13px;
      line-height: 20px;
    }
  }
</style>
