---
/**
 * Six-step workflow strip (03-design-system.md, Workflow steps). Step 04 is highlighted.
 * Phone: vertical rows with number and the phone title only.
 */
interface Step {
  num: string;
  label: string;
  title: string;
  titleMobile: string;
  description: string;
  highlight?: boolean;
}
interface Props {
  label: string;
  steps: Step[];
}
const { label, steps } = Astro.props;
---

<ol class="steps" aria-label={label}>
  {steps.map((s) => (
    <li class:list={['step', s.highlight && 'step--highlight']}>
      <span class="step__label mono">
        {s.num}
        <span class="bp-desktop"> · {s.label}</span>
      </span>
      <span class="step__title">
        <span class="bp-desktop">{s.title}</span>
        <span class="bp-mobile">{s.titleMobile}</span>
      </span>
      <span class="step__desc bp-desktop">{s.description}</span>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .step--highlight {
    padding: 17px;
    border: 2px solid var(--accent-text);
  }

  .step__label {
    font-size: 13px;
    line-height: 20px;
    color: var(--electric);
  }

  .step--highlight .step__label {
    color: var(--accent-text);
  }

  .step__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    line-height: 22px;
    color: var(--ink);
  }

  .step__desc {
    font-size: 14px;
    line-height: 22px;
    color: var(--text-muted);
  }

  @media (max-width: 1119px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
      margin-top: var(--space-4);
    }

    .step {
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
      padding: 12px 14px;
      border-radius: var(--radius-md);
    }

    .step--highlight {
      padding: 11px 13px;
    }

    .step__label {
      font-size: 12px;
    }

    .step__title {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 15px;
      line-height: 20px;
    }
  }
</style>
