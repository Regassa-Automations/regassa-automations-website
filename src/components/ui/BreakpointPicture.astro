---
/**
 * An eager image whose alt text differs between desktop and phone (content/mobile files).
 * Renders two <picture> elements, one per breakpoint (bp-desktop / bp-mobile). Each starts with a
 * media-guarded <source> pointing at a 1x1 transparent GIF for the other breakpoint, so the hidden
 * variant never downloads the real image (display:none does not stop eager image requests).
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  altMobile: string;
  widths: number[];
  widthsMobile: number[];
  sizes: string;
  sizesMobile: string;
  class?: string;
}
const {
  src,
  alt,
  altMobile,
  widths,
  widthsMobile,
  sizes,
  sizesMobile,
  class: className,
} = Astro.props;

const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const set = async (w: number[], format: 'avif' | 'webp') =>
  (await getImage({ src, widths: w, format })).srcSet.attribute;
const fallback = await getImage({ src, width: Math.max(...widths), format: 'webp' });

const desktop = { avif: await set(widths, 'avif'), webp: await set(widths, 'webp') };
const mobile = { avif: await set(widthsMobile, 'avif'), webp: await set(widthsMobile, 'webp') };
---

<picture class="bp-desktop">
  <source media="(max-width: 767px)" srcset={BLANK} />
  <source type="image/avif" srcset={desktop.avif} sizes={sizes} />
  <source type="image/webp" srcset={desktop.webp} sizes={sizes} />
  <img
    class={className}
    src={fallback.src}
    alt={alt}
    width={src.width}
    height={src.height}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</picture>
<picture class="bp-mobile">
  <source media="(min-width: 768px)" srcset={BLANK} />
  <source type="image/avif" srcset={mobile.avif} sizes={sizesMobile} />
  <source type="image/webp" srcset={mobile.webp} sizes={sizesMobile} />
  <img
    class={className}
    src={fallback.src}
    alt={altMobile}
    width={src.width}
    height={src.height}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</picture>
