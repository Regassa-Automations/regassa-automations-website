---
/**
 * Freight architecture diagram, copied from content/work/freight-rate-sheet-generator.md.
 * Drawing unchanged; the inline style attribute moved to CSS (ArchitectureDiagram) for the CSP.
 */
---

<svg
  focusable="false"
  role="img"
  aria-label="Architecture: an operator, who also reviews exceptions, uses an authenticated browser connected to a Cloud Run application that runs route matching, pricing and PDF generation. The application reads and writes structured records in Google Sheets, stores and retrieves saved PDFs in Google Drive, and reads notes and terms content from Google Docs."
  viewBox="0 0 960 340"
>
  <defs>
    <marker
      id="ah"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="8"
      markerHeight="8"
      orient="auto-start-reverse"
    >
      <path d="M0 0L10 5L0 10z" fill="#5A6283" />
    </marker>
  </defs>
  <rect x="8" y="115" width="180" height="110" rx="8" fill="#F6F7FB" stroke="#A9B0C8" />
  <text x="98" y="150" text-anchor="middle" font-size="15" font-weight="600" fill="#0F0F23">
    Operator
  </text>
  <text x="98" y="172" text-anchor="middle" font-size="13" fill="#5A6283">
    Authenticated browser
  </text>
  <rect x="30" y="186" width="136" height="26" rx="13" fill="#FDF1F5" stroke="#F3C6D7" />
  <text x="98" y="204" text-anchor="middle" font-size="12" font-weight="600" fill="#A3174C">
    Reviews exceptions
  </text>
  <line
    x1="192"
    y1="170"
    x2="282"
    y2="170"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-start="url(#ah)"
    marker-end="url(#ah)"
  />
  <rect
    x="286"
    y="20"
    width="368"
    height="300"
    rx="10"
    fill="#FFFFFF"
    stroke="#1E3A8A"
    stroke-width="2"
  />
  <text
    x="470"
    y="54"
    text-anchor="middle"
    font-size="15"
    font-weight="700"
    fill="#1E3A8A"
    font-family="Montserrat, Arial, sans-serif"
  >
    Cloud Run application
  </text>
  <text x="470" y="76" text-anchor="middle" font-size="13" fill="#5A6283">
    Node.js and Express
  </text>
  <rect x="316" y="100" width="308" height="52" rx="6" fill="#E8ECFB" />
  <text x="470" y="131" text-anchor="middle" font-size="14" font-weight="600" fill="#1E3A8A">
    Route matching
  </text>
  <rect x="316" y="166" width="308" height="52" rx="6" fill="#E8ECFB" />
  <text x="470" y="197" text-anchor="middle" font-size="14" font-weight="600" fill="#1E3A8A">
    Pricing
  </text>
  <rect x="316" y="232" width="308" height="60" rx="6" fill="#E8ECFB" />
  <text x="470" y="258" text-anchor="middle" font-size="14" font-weight="600" fill="#1E3A8A">
    PDF generation
  </text>
  <text x="470" y="278" text-anchor="middle" font-size="12" fill="#5A6283">
    Puppeteer and Chromium
  </text>
  <rect x="772" y="20" width="180" height="80" rx="8" fill="#F6F7FB" stroke="#A9B0C8" />
  <text x="862" y="54" text-anchor="middle" font-size="15" font-weight="600" fill="#0F0F23">
    Google Sheets
  </text>
  <text x="862" y="76" text-anchor="middle" font-size="13" fill="#5A6283">
    Structured records
  </text>
  <rect x="772" y="130" width="180" height="80" rx="8" fill="#F6F7FB" stroke="#A9B0C8" />
  <text x="862" y="164" text-anchor="middle" font-size="15" font-weight="600" fill="#0F0F23">
    Google Drive
  </text>
  <text x="862" y="186" text-anchor="middle" font-size="13" fill="#5A6283">
    Saved PDFs
  </text>
  <rect x="772" y="240" width="180" height="80" rx="8" fill="#F6F7FB" stroke="#A9B0C8" />
  <text x="862" y="274" text-anchor="middle" font-size="15" font-weight="600" fill="#0F0F23">
    Google Docs
  </text>
  <text x="862" y="296" text-anchor="middle" font-size="13" fill="#5A6283">
    Notes and terms
  </text>
  <line
    x1="658"
    y1="60"
    x2="768"
    y2="60"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-start="url(#ah)"
    marker-end="url(#ah)"
  />
  <text x="713" y="50" text-anchor="middle" font-size="12" fill="#5A6283">
    read, write
  </text>
  <line
    x1="658"
    y1="170"
    x2="768"
    y2="170"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-start="url(#ah)"
    marker-end="url(#ah)"
  />
  <text x="713" y="160" text-anchor="middle" font-size="12" fill="#5A6283">
    store, retrieve
  </text>
  <line
    x1="768"
    y1="280"
    x2="658"
    y2="280"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#ah)"
  />
  <text x="713" y="270" text-anchor="middle" font-size="12" fill="#5A6283">
    read
  </text>
</svg>
