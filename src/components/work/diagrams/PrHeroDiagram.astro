---
/** PR sync hero diagram, copied from content/work/pr-pipeline-sync.md (marker ha-pr). Drawing unchanged; inline style moved to CSS (CSP). */
---

<svg
  class="hero-svg"
  focusable="false"
  role="img"
  aria-label="Diagram: the agency's master pipeline, edited by about 20 staff, publishes records through the sync script to about 30 separate client trackers, each with Pipeline and Secured tabs. A KPI summary for leadership reads from the master pipeline."
  viewBox="0 0 520 380"
>
  <defs>
    <marker
      id="ha-pr"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto"
    >
      <path d="M0 0L10 5L0 10z" fill="#5A6283" />
    </marker>
  </defs>
  <rect
    x="0"
    y="120"
    width="170"
    height="130"
    rx="10"
    fill="#FFFFFF"
    stroke="#1E3A8A"
    stroke-width="2"
  />
  <text
    x="85"
    y="152"
    text-anchor="middle"
    font-size="15"
    font-weight="700"
    fill="#1E3A8A"
    font-family="Montserrat, Arial, sans-serif"
  >
    Master pipeline
  </text>
  <text x="85" y="174" text-anchor="middle" font-size="12" fill="#5A6283">
    Source of truth
  </text>
  <rect x="18" y="190" width="134" height="44" rx="6" fill="#E8ECFB" />
  <text x="85" y="208" text-anchor="middle" font-size="12" font-weight="600" fill="#1E3A8A">
    ~20 staff edit here
  </text>
  <text x="85" y="224" text-anchor="middle" font-size="11" fill="#5A6283">
    IDs, dropdowns, sync status
  </text>
  <rect x="200" y="160" width="100" height="50" rx="25" fill="#C81E5E" />
  <text x="250" y="190" text-anchor="middle" font-size="13" font-weight="600" fill="#FFFFFF">
    Sync script
  </text>
  <line
    x1="174"
    y1="185"
    x2="196"
    y2="185"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#ha-pr)"
  />
  <g font-size="12">
    <rect x="350" y="10" width="170" height="54" rx="8" fill="#FFFFFF" stroke="#A9B0C8" />
    <text x="364" y="32" font-weight="600" fill="#0F0F23">
      Client A tracker
    </text>
    <text x="364" y="51" fill="#5A6283">
      Pipeline · Secured
    </text>
    <rect x="350" y="76" width="170" height="54" rx="8" fill="#FFFFFF" stroke="#A9B0C8" />
    <text x="364" y="98" font-weight="600" fill="#0F0F23">
      Client B tracker
    </text>
    <text x="364" y="117" fill="#5A6283">
      Pipeline · Secured
    </text>
    <rect x="350" y="142" width="170" height="54" rx="8" fill="#FFFFFF" stroke="#A9B0C8" />
    <text x="364" y="164" font-weight="600" fill="#0F0F23">
      Client C tracker
    </text>
    <text x="364" y="183" fill="#5A6283">
      Pipeline · Secured
    </text>
    <rect
      x="350"
      y="208"
      width="170"
      height="40"
      rx="8"
      fill="none"
      stroke="#A9B0C8"
      stroke-dasharray="4 4"
    />
    <text x="435" y="233" text-anchor="middle" font-weight="600" fill="#5A6283">
      … about 30 in all
    </text>
  </g>
  <line
    x1="304"
    y1="176"
    x2="346"
    y2="40"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#ha-pr)"
  />
  <line
    x1="304"
    y1="180"
    x2="346"
    y2="104"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#ha-pr)"
  />
  <line
    x1="304"
    y1="186"
    x2="346"
    y2="170"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#ha-pr)"
  />
  <line
    x1="304"
    y1="192"
    x2="346"
    y2="226"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#ha-pr)"
  />
  <rect x="0" y="300" width="170" height="64" rx="8" fill="#FDF1F5" stroke="#F3C6D7" />
  <text x="85" y="327" text-anchor="middle" font-size="13" font-weight="600" fill="#A3174C">
    KPI summary
  </text>
  <text x="85" y="346" text-anchor="middle" font-size="11" fill="#5A6283">
    For agency leadership
  </text>
  <line
    x1="85"
    y1="254"
    x2="85"
    y2="296"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#ha-pr)"
  />
</svg>

<style>
  .hero-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }
</style>
