---
/** PR sync phone hero diagram, copied from content/mobile/pr-pipeline-sync-mobile.md (marker hm-pr). Drawing unchanged; inline style moved to CSS (CSP). */
---

<svg
  class="hero-svg"
  focusable="false"
  role="img"
  aria-label="Diagram: one master pipeline feeds a sync script, which publishes to about 30 client trackers."
  viewBox="0 0 340 200"
>
  <defs>
    <marker
      id="hm-pr"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto"
    >
      <path d="M0 0L10 5L0 10z" fill="#5A6283" />
    </marker>
  </defs>
  <rect
    x="0"
    y="70"
    width="104"
    height="60"
    rx="8"
    fill="#FFFFFF"
    stroke="#1E3A8A"
    stroke-width="2"
  />
  <text x="52" y="96" text-anchor="middle" font-size="12" font-weight="700" fill="#1E3A8A">
    Master
  </text>
  <text x="52" y="113" text-anchor="middle" font-size="12" font-weight="700" fill="#1E3A8A">
    pipeline
  </text>
  <rect x="124" y="82" width="74" height="36" rx="18" fill="#C81E5E" />
  <text x="161" y="105" text-anchor="middle" font-size="11" font-weight="600" fill="#FFFFFF">
    Sync
  </text>
  <line
    x1="106"
    y1="100"
    x2="120"
    y2="100"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#hm-pr)"
  />
  <g font-size="11" font-weight="600" fill="#0F0F23">
    <rect x="230" y="4" width="110" height="38" rx="6" fill="#FFFFFF" stroke="#A9B0C8" />
    <text x="242" y="27">
      Client A
    </text>
    <rect x="230" y="52" width="110" height="38" rx="6" fill="#FFFFFF" stroke="#A9B0C8" />
    <text x="242" y="75">
      Client B
    </text>
    <rect x="230" y="100" width="110" height="38" rx="6" fill="#FFFFFF" stroke="#A9B0C8" />
    <text x="242" y="123">
      Client C
    </text>
    <rect
      x="230"
      y="148"
      width="110"
      height="38"
      rx="6"
      fill="none"
      stroke="#A9B0C8"
      stroke-dasharray="4 4"
    />
    <text x="242" y="171" fill="#5A6283">
      … about 30
    </text>
  </g>
  <line
    x1="200"
    y1="94"
    x2="226"
    y2="24"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#hm-pr)"
  />
  <line
    x1="200"
    y1="98"
    x2="226"
    y2="72"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#hm-pr)"
  />
  <line
    x1="200"
    y1="102"
    x2="226"
    y2="118"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#hm-pr)"
  />
  <line
    x1="200"
    y1="106"
    x2="226"
    y2="164"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#hm-pr)"
  />
</svg>

<style>
  .hero-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }
</style>
