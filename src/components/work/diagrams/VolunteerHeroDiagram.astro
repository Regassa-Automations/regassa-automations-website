---
/** Volunteer rosters hero diagram, copied from content/work/volunteer-rosters.md (marker va). Drawing unchanged; inline style moved to CSS (CSP). */
---

<svg
  class="hero-svg"
  focusable="false"
  role="img"
  aria-label="Diagram: registration forms for each location and SignUpGenius sign-ups feed an Apps Script automation, which updates four separate location rosters. Editable wording documents keep each form's title and description current."
  viewBox="0 0 520 360"
>
  <defs>
    <marker
      id="va"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto"
    >
      <path d="M0 0L10 5L0 10z" fill="#5A6283" />
    </marker>
  </defs>
  <text x="0" y="14" font-size="11" font-weight="600" letter-spacing="1.5" fill="#5A6283">
    SOURCES
  </text>
  <rect x="0" y="30" width="160" height="70" rx="8" fill="#FFFFFF" stroke="#A9B0C8" />
  <text x="80" y="58" text-anchor="middle" font-size="14" font-weight="600" fill="#0F0F23">
    Google Forms
  </text>
  <text x="80" y="78" text-anchor="middle" font-size="11" fill="#5A6283">
    One per location
  </text>
  <rect x="0" y="130" width="160" height="70" rx="8" fill="#FFFFFF" stroke="#A9B0C8" />
  <text x="80" y="158" text-anchor="middle" font-size="14" font-weight="600" fill="#0F0F23">
    SignUpGenius
  </text>
  <text x="80" y="178" text-anchor="middle" font-size="11" fill="#5A6283">
    Role sign-ups, via API
  </text>
  <rect x="0" y="260" width="160" height="70" rx="8" fill="#FDF1F5" stroke="#F3C6D7" />
  <text x="80" y="288" text-anchor="middle" font-size="13" font-weight="600" fill="#A3174C">
    Wording docs
  </text>
  <text x="80" y="308" text-anchor="middle" font-size="11" fill="#5A6283">
    Form titles, descriptions
  </text>
  <line
    x1="80"
    y1="256"
    x2="80"
    y2="104"
    stroke="#A3174C"
    stroke-width="1.2"
    stroke-dasharray="4 3"
    marker-end="url(#va)"
  />
  <rect x="200" y="90" width="120" height="70" rx="35" fill="#C81E5E" />
  <text x="260" y="121" text-anchor="middle" font-size="13" font-weight="600" fill="#FFFFFF">
    Apps Script
  </text>
  <text x="260" y="139" text-anchor="middle" font-size="11" fill="#FDF1F5">
    route · match · merge
  </text>
  <line
    x1="164"
    y1="65"
    x2="200"
    y2="108"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#va)"
  />
  <line
    x1="164"
    y1="165"
    x2="200"
    y2="142"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#va)"
  />
  <g font-size="12" font-weight="600" fill="#0F0F23">
    <rect
      x="360"
      y="20"
      width="160"
      height="44"
      rx="8"
      fill="#FFFFFF"
      stroke="#1E3A8A"
      stroke-width="1.5"
    />
    <text x="376" y="47">
      Location 1 roster
    </text>
    <rect
      x="360"
      y="74"
      width="160"
      height="44"
      rx="8"
      fill="#FFFFFF"
      stroke="#1E3A8A"
      stroke-width="1.5"
    />
    <text x="376" y="101">
      Location 2 roster
    </text>
    <rect
      x="360"
      y="128"
      width="160"
      height="44"
      rx="8"
      fill="#FFFFFF"
      stroke="#1E3A8A"
      stroke-width="1.5"
    />
    <text x="376" y="155">
      Location 3 roster
    </text>
    <rect
      x="360"
      y="182"
      width="160"
      height="44"
      rx="8"
      fill="#FFFFFF"
      stroke="#1E3A8A"
      stroke-width="1.5"
    />
    <text x="376" y="209">
      Location 4 roster
    </text>
  </g>
  <line
    x1="322"
    y1="118"
    x2="356"
    y2="42"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#va)"
  />
  <line
    x1="322"
    y1="122"
    x2="356"
    y2="96"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#va)"
  />
  <line
    x1="322"
    y1="128"
    x2="356"
    y2="150"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#va)"
  />
  <line
    x1="322"
    y1="132"
    x2="356"
    y2="204"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#va)"
  />
  <text x="440" y="252" text-anchor="middle" font-size="11" fill="#5A6283">
    Changed rows highlighted
  </text>
  <text x="440" y="268" text-anchor="middle" font-size="11" fill="#5A6283">
    for coordinators
  </text>
</svg>

<style>
  .hero-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }
</style>
