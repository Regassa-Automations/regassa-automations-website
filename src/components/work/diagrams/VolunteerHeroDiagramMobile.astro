---
/** Volunteer rosters phone hero diagram, copied from content/mobile/volunteer-rosters-mobile.md (marker vm). Drawing unchanged; inline style moved to CSS (CSP). */
---

<svg
  class="hero-svg"
  focusable="false"
  role="img"
  aria-label="Diagram: Google Forms and SignUpGenius feed an Apps Script automation, which updates four location rosters."
  viewBox="0 0 340 200"
>
  <defs>
    <marker
      id="vm"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto"
    >
      <path d="M0 0L10 5L0 10z" fill="#5A6283" />
    </marker>
  </defs>
  <rect x="0" y="40" width="100" height="44" rx="8" fill="#FFFFFF" stroke="#A9B0C8" />
  <text x="50" y="67" text-anchor="middle" font-size="12" font-weight="600" fill="#0F0F23">
    Google Forms
  </text>
  <rect x="0" y="116" width="100" height="44" rx="8" fill="#FFFFFF" stroke="#A9B0C8" />
  <text x="50" y="143" text-anchor="middle" font-size="12" font-weight="600" fill="#0F0F23">
    SignUpGenius
  </text>
  <rect x="124" y="82" width="80" height="36" rx="18" fill="#C81E5E" />
  <text x="164" y="105" text-anchor="middle" font-size="11" font-weight="600" fill="#FFFFFF">
    Apps Script
  </text>
  <line
    x1="102"
    y1="62"
    x2="122"
    y2="92"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#vm)"
  />
  <line
    x1="102"
    y1="138"
    x2="122"
    y2="108"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#vm)"
  />
  <g font-size="11" font-weight="600" fill="#0F0F23">
    <rect x="236" y="4" width="104" height="38" rx="6" fill="#FFFFFF" stroke="#1E3A8A" />
    <text x="248" y="27">
      Location 1
    </text>
    <rect x="236" y="52" width="104" height="38" rx="6" fill="#FFFFFF" stroke="#1E3A8A" />
    <text x="248" y="75">
      Location 2
    </text>
    <rect x="236" y="100" width="104" height="38" rx="6" fill="#FFFFFF" stroke="#1E3A8A" />
    <text x="248" y="123">
      Location 3
    </text>
    <rect x="236" y="148" width="104" height="38" rx="6" fill="#FFFFFF" stroke="#1E3A8A" />
    <text x="248" y="171">
      Location 4
    </text>
  </g>
  <line
    x1="206"
    y1="94"
    x2="232"
    y2="24"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#vm)"
  />
  <line
    x1="206"
    y1="98"
    x2="232"
    y2="72"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#vm)"
  />
  <line
    x1="206"
    y1="102"
    x2="232"
    y2="118"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#vm)"
  />
  <line
    x1="206"
    y1="106"
    x2="232"
    y2="164"
    stroke="#5A6283"
    stroke-width="1.5"
    marker-end="url(#vm)"
  />
</svg>

<style>
  .hero-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }
</style>
