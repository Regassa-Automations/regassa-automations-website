---
/** Six-step cycle with hex numerals; two columns of three (column flow), one column under 900 px. */
import HexNumeral from './HexNumeral.astro';
import Responsive from '../../ui/Responsive.astro';

interface Step {
  title: string;
  titleMobile?: string;
  text: string;
  textMobile?: string;
  accent?: boolean;
  hideMobile?: boolean;
}
interface Props {
  title?: string;
  sub?: string;
  steps: Step[];
  headingLevel?: 3;
}
const { title, sub, steps } = Astro.props;
// Step headings sit one level under the cycle title (H3), or directly under the section H2.
const StepH = title ? 'h4' : 'h3';
---

<div class="cycle">
  {title && <h3 class="cycle__title">{title}</h3>}
  {sub && <p class="cycle__sub bp-desktop">{sub}</p>}
  <ol class="cycle__list">
    {steps.map((s, i) => (
      <li class:list={['cycle__step', s.hideMobile && 'bp-desktop']}>
        <HexNumeral n={i + 1} accent={s.accent} />
        <div>
          <StepH class="cycle__step-title">
            <Responsive text={s.title} textMobile={s.titleMobile} />
          </StepH>
          <Responsive as="p" class="cycle__text" text={s.text} textMobile={s.textMobile} />
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .cycle {
    margin-top: 40px;
  }

  .cycle__title {
    font-size: 20px;
    line-height: 28px;
  }

  .cycle__sub {
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: 15px;
    line-height: 24px;
  }

  .cycle__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    column-gap: 40px;
    margin-top: var(--space-6);
  }

  .cycle__step {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .cycle__step-title {
    font-family: var(--font-display);
    font-size: 16px;
    line-height: 22px;
    color: var(--ink);
  }

  .cycle :global(.cycle__text) {
    margin-top: 2px;
    font-size: 14px;
    line-height: 22px;
    color: var(--text-strong-muted);
  }

  @media (max-width: 899px) {
    .cycle__list {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }

  @media (max-width: 767px) {
    .cycle {
      margin-top: var(--space-8);
    }

    .cycle__title {
      font-size: 18px;
      line-height: 26px;
    }

    .cycle__list {
      margin-top: var(--space-3);
    }

    .cycle__step {
      padding-block: var(--space-3);
    }
  }
</style>
