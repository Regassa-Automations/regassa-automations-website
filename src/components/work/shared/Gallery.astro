---
/**
 * Case-study gallery (04-interactions-and-responsive.md, Gallery dialog).
 * Thumbnails are links to the full-size image (works without JS); src/scripts/gallery.ts
 * upgrades them to buttons ("View larger: {title}") that open the shared GalleryDialog.
 * Phones use plain figures instead (per the content/mobile files), so this is desktop-only.
 */
import { Picture } from 'astro:assets';
import type { GalleryItem } from './gallery-types';

interface Props {
  items: GalleryItem[];
  /** Only the first `count` items are shown as thumbnails (GridBloom opens the rest elsewhere). */
  count?: number;
  label: string;
}
const { items, count = items.length, label } = Astro.props;
---

<ul class="gallery bp-desktop" role="list" aria-label={label}>
  {items.slice(0, count).map((item, i) => (
    <li class="gallery__item">
      <a class="gallery__thumb" href={item.image.src} data-gallery-open={i} data-title={item.title}>
        <Picture
          src={item.image}
          alt={item.alt}
          formats={['avif', 'webp']}
          widths={[400, 640, 960]}
          sizes="(min-width: 1104px) 510px, 45vw"
          loading="lazy"
        />
      </a>
      <p class="gallery__title">{item.title}</p>
      <p class="gallery__caption">{item.caption}</p>
    </li>
  ))}
</ul>

<style>
  .gallery {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    margin-top: 40px;
  }

  .gallery__thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-paper);
  }

  /* After JS upgrade the thumbnail is a <button>. */
  button.gallery__thumb {
    width: 100%;
    padding: 0;
    cursor: zoom-in;
  }

  .gallery__thumb:hover {
    border-color: var(--electric);
  }

  .gallery__thumb :global(picture) {
    display: block;
    height: 100%;
  }

  .gallery__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .gallery__title {
    margin-top: var(--space-3);
    font-weight: 600;
    font-size: 15px;
    line-height: 22px;
    color: var(--ink);
  }

  .gallery__caption {
    margin-top: 2px;
    font-size: 14px;
    line-height: 22px;
    color: var(--text-muted);
  }

  @media (max-width: 699px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
