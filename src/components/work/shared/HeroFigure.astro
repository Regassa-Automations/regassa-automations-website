---
/**
 * Framed case-study hero figure: paper panel (28 px padding, none at the bottom), image cropped
 * from the top to 400 px (phone height given per page), top corners radius 6, figure shadow.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Responsive from '../../ui/Responsive.astro';
import BreakpointPicture from '../../ui/BreakpointPicture.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  altMobile?: string;
  caption: string;
  captionMobile?: string;
  heightMobile: 220 | 230;
  position?: 'top' | 'top-left';
}
const {
  image,
  alt,
  altMobile,
  caption,
  captionMobile,
  heightMobile,
  position = 'top',
} = Astro.props;
const sizesD = '(min-width: 1232px) 560px, (min-width: 960px) 45vw, 100vw';
---

<figure class="hfig" data-hm={heightMobile} data-pos={position}>
  <div class="hfig__panel">
    {altMobile ? (
      <BreakpointPicture
        src={image}
        alt={alt}
        altMobile={altMobile}
        widths={[480, 720, 960, 1200]}
        widthsMobile={[400, 720]}
        sizes={sizesD}
        sizesMobile="calc(100vw - 32px)"
      />
    ) : (
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[400, 720, 960, 1200]}
        sizes={sizesD}
        loading="eager"
        fetchpriority="high"
      />
    )}
  </div>
  <figcaption class="hfig__caption">
    <Responsive text={caption} textMobile={captionMobile} />
  </figcaption>
</figure>

<style>
  .hfig__panel {
    padding: 28px 28px 0;
    background: var(--surface-paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .hfig__panel :global(img) {
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center top;
    border-radius: 6px 6px 0 0;
    box-shadow: var(--shadow-figure);
  }

  [data-pos='top-left'] .hfig__panel :global(img) {
    object-position: left top;
  }

  .hfig__caption {
    margin-top: var(--space-3);
    font-size: 14px;
    line-height: 22px;
    color: var(--text-muted);
  }

  @media (max-width: 767px) {
    .hfig__panel {
      padding: 16px 16px 0;
    }

    [data-hm='230'] .hfig__panel :global(img) {
      height: 230px;
    }

    [data-hm='220'] .hfig__panel :global(img) {
      height: 220px;
    }
  }
</style>
