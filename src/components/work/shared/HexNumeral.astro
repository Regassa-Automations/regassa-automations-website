---
/** 36x40 hexagon numeral (03-design-system.md, Brand devices). Navy, or accent for a human step. */
interface Props {
  n: string | number;
  accent?: boolean;
  class?: string;
}
const { n, accent = false, class: className } = Astro.props;
---

<span class:list={['hexnum', accent && 'hexnum--accent', className]} aria-hidden="true">
  {n}
</span>

<style>
  .hexnum {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 40px;
    background: var(--navy);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 14px;
    color: var(--on-navy);
  }

  .hexnum--accent {
    background: var(--accent-text);
  }
</style>
