---
/** Technology chips (`ul aria-label="Technologies used"`). Phone list may differ. */
interface Props {
  items: string[];
  itemsMobile?: string[];
}
const { items, itemsMobile } = Astro.props;
const mobile = itemsMobile ?? items;
---

<ul class="chips" aria-label="Technologies used">
  {items.map((t) => (
    <li class:list={['chip', !mobile.includes(t) && 'bp-desktop']}>{t}</li>
  ))}
  {mobile
    .filter((t) => !items.includes(t))
    .map((t) => (
      <li class="chip bp-mobile">{t}</li>
    ))}
</ul>

<style>
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    padding: var(--space-1) 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    color: var(--text-strong-muted);
  }
</style>
