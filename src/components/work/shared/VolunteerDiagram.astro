---
/**
 * "Two sign-up tools to four rosters" mini-diagram (content/portfolio.md, card 3).
 * Shapes, text and colors as supplied; the inline style attribute moved to CSS (CSP).
 */
---

<div class="vdiagram">
  <svg
    role="img"
    aria-label="Google Forms and SignUpGenius feeding four location rosters"
    viewBox="0 0 300 150"
    font-family="Inter, sans-serif"
  >
    <g fill="#FFFFFF" stroke="#A9B0C8">
      <rect x="0" y="26" width="104" height="36" rx="6"></rect>
      <rect x="0" y="88" width="104" height="36" rx="6"></rect>
    </g>
    <g font-size="11" font-weight="600" fill="#0F0F23">
      <text x="12" y="48">
        Google Forms
      </text>
      <text x="12" y="110">
        SignUpGenius
      </text>
    </g>
    <g fill="#FFFFFF" stroke="#1E3A8A" stroke-width="1.5">
      <rect x="196" y="4" width="104" height="28" rx="6"></rect>
      <rect x="196" y="42" width="104" height="28" rx="6"></rect>
      <rect x="196" y="80" width="104" height="28" rx="6"></rect>
      <rect x="196" y="118" width="104" height="28" rx="6"></rect>
    </g>
    <g font-size="11" fill="#0F0F23">
      <text x="208" y="22">
        Location 1
      </text>
      <text x="208" y="60">
        Location 2
      </text>
      <text x="208" y="98">
        Location 3
      </text>
      <text x="208" y="136">
        Location 4
      </text>
    </g>
    <circle cx="150" cy="75" r="14" fill="#C81E5E"></circle>
    <g stroke="#5A6283" stroke-width="1.5">
      <line x1="106" y1="44" x2="136" y2="70"></line>
      <line x1="106" y1="106" x2="136" y2="80"></line>
      <line x1="164" y1="75" x2="192" y2="18"></line>
      <line x1="164" y1="75" x2="192" y2="56"></line>
      <line x1="164" y1="75" x2="192" y2="94"></line>
      <line x1="164" y1="75" x2="192" y2="132"></line>
    </g>
  </svg>
</div>

<style>
  .vdiagram {
    height: 100%;
    padding: 20px;
    background: var(--surface-paper);
  }

  .vdiagram svg {
    width: 100%;
    height: 100%;
  }
</style>
