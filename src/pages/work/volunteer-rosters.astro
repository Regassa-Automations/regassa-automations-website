---
/**
 * Case study: Volunteer rosters (content/work/volunteer-rosters.md;
 * phone: content/mobile/volunteer-rosters-mobile.md). Never name the organization or towns (OI-16).
 * The review is a real Upwork review from projects.yaml, quoted exactly; no review markup.
 */
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import Responsive from '../../components/ui/Responsive.astro';
import RichText from '../../components/ui/RichText.astro';
import HexMarker from '../../components/ui/HexMarker.astro';
import CaseStudyHero from '../../components/work/shared/CaseStudyHero.astro';
import JumpLinks from '../../components/work/shared/JumpLinks.astro';
import CaseSection from '../../components/work/shared/CaseSection.astro';
import ChallengeCards from '../../components/work/shared/ChallengeCards.astro';
import SheetMock from '../../components/work/shared/SheetMock.astro';
import CycleSteps from '../../components/work/shared/CycleSteps.astro';
import Callout from '../../components/work/shared/Callout.astro';
import ReviewBand from '../../components/work/shared/ReviewBand.astro';
import BeforeAfterTable from '../../components/work/shared/BeforeAfterTable.astro';
import IndustryCards from '../../components/work/shared/IndustryCards.astro';
import TechChips from '../../components/work/shared/TechChips.astro';
import Accordion from '../../components/work/shared/Accordion.astro';
import NextStepBand from '../../components/work/shared/NextStepBand.astro';
import MoreCaseStudies from '../../components/work/shared/MoreCaseStudies.astro';
import PathCards from '../../components/work/specific/PathCards.astro';
import VolunteerHeroDiagram from '../../components/work/diagrams/VolunteerHeroDiagram.astro';
import VolunteerHeroDiagramMobile from '../../components/work/diagrams/VolunteerHeroDiagramMobile.astro';
import { site } from '../../config/site';
import * as d from '../../data/work/volunteers';
import { caseStudy } from '../../lib/jsonld';

const jsonLd = caseStudy({
  name: d.hero.h1,
  description: d.hero.lede,
  path: '/work/volunteer-rosters/',
  crumb: d.hero.crumb,
});

const review = (await getEntry('reviews', 'volunteer'))?.data;
if (!review?.full) throw new Error('Volunteer review missing from projects.yaml');
---

<Base
  title={d.meta.title}
  description={d.meta.description}
  ogTitle={d.meta.ogTitle}
  ogDescription={d.meta.ogDescription}
  ogImage={d.meta.ogImage}
  ogImageAlt={d.meta.ogImageAlt}
  current="portfolio"
  jsonLd={jsonLd}
>
  <CaseStudyHero
    crumb={d.hero.crumb}
    tags={d.hero.tags}
    tagsMobile={d.hero.tagsMobile}
    h1={d.hero.h1}
    lede={d.hero.lede}
    ledeMobile={d.hero.ledeMobile}
    facts={d.hero.facts}
    factsNoteMobile={d.hero.factsNoteMobile}
  >
    <Fragment slot="actions">
      <Button href={site.bookingUrl} external>
        Pick a time on my calendar
      </Button>
      <Button href={d.hero.secondary.href} variant="secondary">
        {d.hero.secondary.label}
      </Button>
    </Fragment>
    <figure slot="figure">
      <div class="vr-panel">
        <div class="bp-desktop">
          <VolunteerHeroDiagram />
        </div>
        <div class="bp-mobile">
          <VolunteerHeroDiagramMobile />
        </div>
      </div>
      <figcaption class="vr-caption">
        <Responsive text={d.hero.caption} textMobile={d.hero.captionMobile} />
      </figcaption>
    </figure>
    <JumpLinks slot="after" items={d.jumps} />
  </CaseStudyHero>

  <CaseSection id="overview" num={d.overview.num} title={d.overview.h2}>
    <Fragment slot="intro">
      {d.overview.body.map((p) => (
        <p class="bp-desktop">{p}</p>
      ))}
      <p class="bp-mobile">{d.overview.bodyMobile}</p>
    </Fragment>
    <ChallengeCards items={d.overview.cards} />
  </CaseSection>

  <CaseSection id="paths" num={d.paths.num} title={d.paths.h2} titleMobile={d.paths.h2Mobile} paper>
    <p slot="intro" class="bp-desktop">
      {d.paths.intro}
    </p>
    <PathCards cards={d.paths.cards} />
  </CaseSection>

  <CaseSection id="merge" num={d.merge.num} title={d.merge.h2}>
    <Responsive as="p" slot="intro" text={d.merge.body} textMobile={d.merge.bodyMobile} />
    <figure class="vr-merge bp-desktop">
      <SheetMock
        caption={d.merge.caption}
        captionHidden
        columns={d.merge.columns}
        rows={d.merge.rows}
        rowHeaders
      />
      <figcaption class="vr-caption">{d.merge.legend}</figcaption>
    </figure>
    <div class="bp-mobile">
      <ul class="vr-records" role="list">
        {d.merge.mobileCards.map((c) => (
          <li class:list={['vr-record', c.tone === 'after' && 'vr-record--after']}>
            <p class:list={['vr-record__label mono', c.tone === 'after' && 'is-after']}>
              {c.label}
            </p>
            <dl>
              {c.rows.map((r) => (
                <div>
                  <dt>{r.k}</dt>
                  <dd class:list={['state' in r && r.state && `is-${r.state}`]}>
                    {r.v}
                    {'state' in r && r.state === 'kept' && (
                      <span class="visually-hidden"> (kept)</span>
                    )}
                    {'state' in r && r.state === 'changed' && (
                      <span class="visually-hidden"> (updated)</span>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ul>
      <p class="vr-caption">{d.merge.legendMobile}</p>
    </div>
    <div class="vr-merge-cards">
      <div class="vr-card">
        <h3 class="vr-card__title">{d.merge.rules.title}</h3>
        <ul class="hex-list vr-card__list">
          {d.merge.rules.items.map((item, i) => (
            <li>
              <HexMarker />
              <Responsive text={item} textMobile={d.merge.rules.itemsMobile[i]} />
            </li>
          ))}
        </ul>
      </div>
      <div class="vr-card vr-card--paper">
        <h3 class="vr-card__title">
          <Responsive text={d.merge.why.title} textMobile={d.merge.why.titleMobile} />
        </h3>
        <Responsive
          as="p"
          class="vr-card__text"
          text={d.merge.why.text}
          textMobile={d.merge.why.textMobile}
        />
        <p class="vr-card__small bp-desktop">{d.merge.why.small}</p>
      </div>
    </div>
  </CaseSection>

  <CaseSection id="coordinators" num={d.coordinators.num} title={d.coordinators.h2} paper>
    <p slot="intro" class="bp-desktop">
      {d.coordinators.intro}
    </p>
    <ChallengeCards items={d.coordinators.cards} labelsMobile={false} />
  </CaseSection>

  <CaseSection id="adoption" num={d.adoption.num} title={d.adoption.h2}>
    <Responsive as="p" slot="intro" text={d.adoption.body} textMobile={d.adoption.bodyMobile} />
    <CycleSteps steps={d.adoption.steps} />
    <Callout
      class="vr-callout"
      icon="check"
      title={d.adoption.callout.title}
      body={d.adoption.callout.body}
      bodyMobile={d.adoption.callout.bodyMobile}
    />
  </CaseSection>

  <ReviewBand quote={review.excerpt} rest={review.full} wrapQuotesMobile />

  <CaseSection id="results" num={d.results.num} title={d.results.h2} paper stacked>
    <BeforeAfterTable
      caption={d.results.tableCaption}
      columns={d.results.columns}
      rows={d.results.rows}
      mobileCards={d.results.mobileCards}
      mobileLabels={d.results.mobileLabels}
    />
    <Responsive as="p" class="vr-note" text={d.results.note} textMobile={d.results.noteMobile} />
  </CaseSection>

  <CaseSection id="elsewhere" num={d.elsewhere.num} title={d.elsewhere.h2}>
    <Fragment slot="intro">
      <p class="bp-desktop">
        <RichText segments={d.elsewhere.intro} />
      </p>
      <p class="bp-mobile">{d.elsewhere.introMobile}</p>
    </Fragment>
    <IndustryCards items={d.elsewhere.cards} />
  </CaseSection>

  <CaseSection id="technical" num={d.technical.num} title={d.technical.h2} paper>
    <TechChips slot="intro" items={d.technical.chips} itemsMobile={d.technical.chipsMobile} />
    <div class="vr-accordions bp-desktop">
      {d.technical.accordions.map((a) => (
        <Accordion title={a.title}>
          <p>{a.text}</p>
        </Accordion>
      ))}
    </div>
    <div class="vr-accordions bp-mobile">
      {d.technical.mobileAccordions.map((a) => (
        <Accordion title={a.title}>
          <p>{a.text}</p>
        </Accordion>
      ))}
    </div>
  </CaseSection>

  <NextStepBand h2={d.next.h2} body={d.next.body} bodyMobile={d.next.bodyMobile} />
  <MoreCaseStudies current="volunteer-rosters" />
</Base>

<style>
  .vr-panel {
    padding: 28px;
    background: var(--surface-paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .vr-caption {
    margin-top: var(--space-3);
    font-size: 14px;
    line-height: 22px;
    color: var(--text-muted);
  }

  .vr-merge {
    margin-top: 40px;
  }

  .vr-records {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .vr-record {
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-size: 13px;
    line-height: 20px;
  }

  /* Page-scoped illustration colors (content/mobile/volunteer-rosters-mobile.md). */
  .vr-record--after {
    background: #fff7d6;
    border-color: #f0d77a;
  }

  .vr-record__label {
    margin-bottom: var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .vr-record__label.is-after {
    color: var(--electric);
  }

  .vr-record dl > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .vr-record dt {
    color: var(--text-muted);
  }

  .vr-record dd {
    text-align: right;
  }

  .vr-record .is-muted {
    color: var(--text-muted);
  }

  .vr-record .is-kept {
    font-weight: 600;
    color: #1d6b3f;
  }

  .vr-record .is-changed {
    font-weight: 700;
    color: var(--navy);
  }

  .vr-merge-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .vr-card {
    padding: 20px 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .vr-card--paper {
    background: var(--surface-paper);
  }

  .vr-card__title {
    font-size: 18px;
    line-height: 26px;
    color: var(--ink);
  }

  .vr-card__list {
    margin-top: var(--space-3);
    font-size: 15px;
    line-height: 24px;
  }

  :global(.vr-card__text) {
    margin-top: var(--space-2);
    font-size: 15px;
    line-height: 24px;
  }

  .vr-card__small {
    margin-top: var(--space-3);
    font-size: 14px;
    line-height: 22px;
    color: var(--text-muted);
  }

  :global(.vr-callout) {
    margin-top: var(--space-6);
  }

  :global(.vr-note) {
    max-width: 52em;
    margin-top: var(--space-6);
    font-size: 14px;
    line-height: 22px;
    color: var(--text-muted);
  }

  .vr-accordions {
    margin-top: 40px;
  }

  @media (max-width: 767px) {
    .vr-panel {
      padding: 16px;
    }

    .vr-merge-cards {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }

    .vr-card {
      padding: var(--space-4);
    }

    .vr-accordions {
      margin-top: var(--space-6);
    }
  }
</style>
